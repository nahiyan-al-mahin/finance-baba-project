# Copy to .env and fill in. NEVER commit the real .env file.
PORT=3000
NODE_ENV=development
# 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a key is generated into data/secret.key on first start. Losing it makes ALL data unreadable.
APP_SECRET=
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Render, Railway...)
TRUST_PROXY=0
# Enables "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your site URL to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Where the database and generated secret live. On a host, point this at a persistent volume (e.g. /data).
DATA_DIR=
# Optional: create the first admin at start-up (for hosts without a terminal). Remove the password afterwards.
ADMIN_USERNAME=
ADMIN_PASSWORD=
