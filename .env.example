# Copy to .env and fill in. NEVER commit the real .env file.
PORT=3000
NODE_ENV=development

# Neon Postgres connection string (use the *pooled* one, it contains "-pooler").
# Leave empty to use a local database in data/pgdata (no setup needed, handy for development).
DATABASE_URL=

# 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when DATABASE_URL is set. Use the SAME value locally and on Vercel if both use the same database.
# Losing it makes ALL data unreadable.
APP_SECRET=

# Optional: create the first admin at start-up. Remove ADMIN_PASSWORD once the admin exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: enables "Continue with Google" (see README).
GOOGLE_CLIENT_ID=

# Email: verification codes, over-target alerts and month-end PDF reports.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=a 16-letter App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Development without SMTP: print emails (and codes) to the terminal instead.
MAIL_LOG=0
# Link used in emails (Vercel fills this in automatically).
APP_URL=
# Protects the daily month-end report job (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# Only for your own server behind nginx/Caddy (Vercel is detected automatically).
TRUST_PROXY=0
# Local data folder (PGlite database and generated secret when DATABASE_URL is empty).
DATA_DIR=

# Android app (Play Store). SHA-256 fingerprint of the app signing key from Play Console -> App signing.
# Several fingerprints can be separated by commas. See docs/ANDROID.md.
ANDROID_CERT_SHA256=
# ANDROID_PACKAGE=com.financebaba.app
